APP_ENV=development
APP_NAME=AI Job Coach
APP_SECRET_KEY=replace-in-production-with-at-least-32-random-bytes
DATABASE_URL=sqlite:///./var/app.db
FRONTEND_ORIGIN=http://localhost:5173
# API_PORT controls both uvicorn and the Vite /api proxy. Change it if 8000 is occupied.
API_PORT=8000
API_BASE_URL=http://localhost:8000

AUTH_COOKIE_NAME=ai_job_session
AUTH_COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LLM_PROVIDER=mock
LLM_API_BASE_URL=
LLM_API_KEY=
# 旧配置仍可作为两个档位的共同兜底
LLM_MODEL=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
# 单次等待 300 秒，最多再试 1 次。结构化 JSON 默认关闭思考，避免推理把输出截断或拖过超时。
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=8192
LLM_THINKING_ENABLED=false
LLM_REASONING_EFFORT=
# DeepSeek：LLM_PROVIDER=compatible，LLM_API_BASE_URL=https://api.deepseek.com
# LLM_MODEL_CHEAP=deepseek-v4-pro，LLM_MODEL_STRONG=deepseek-v4-pro
# 若确需思考：LLM_THINKING_ENABLED=true，LLM_REASONING_EFFORT=high
# xAI Grok：LLM_PROVIDER=compatible，LLM_API_BASE_URL=https://api.x.ai/v1
# 结构化生成建议 LLM_MODEL_CHEAP/STRONG=grok-4.20-0309-non-reasoning，并保持 THINKING=false
# 本地调试开关；test/production 会强制开启质量硬门禁
RESUME_QUALITY_GATE_ENABLED=true

PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=demo-secret

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./var/uploads
MAX_UPLOAD_MB=10
DATA_RETENTION_DAYS=180
DELETION_GRACE_DAYS=7
JOB_STALE_DAYS=45
# 允许读取 JobPosting JSON-LD 的公开 HTTPS 域名，逗号分隔；支持 *.example.com
JOB_SOURCE_ALLOWED_HOSTS=

DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_ADVISOR_EMAIL=advisor@example.test
DEMO_ADVISOR_PASSWORD=ChangeMe123!
DEMO_USER_EMAIL=user@example.test
DEMO_USER_PASSWORD=ChangeMe123!
