# Production environment for docker-compose.prod.yml.
#   cp .env.production.example .env
# Never commit the real .env. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
APP_NAME=AI Job Coach
APP_SECRET_KEY=CHANGE_ME_generate_32_bytes_of_random

# --- Ingress -----------------------------------------------------------------
# Tunnel mode (Cloudflare): leave SITE_ADDRESS empty and set the tunnel token.
# Direct mode: set SITE_ADDRESS to the public hostname for automatic HTTPS.
SITE_ADDRESS=
CLOUDFLARE_TUNNEL_TOKEN=
# Must match the public URL users open (HTTPS required in production).
FRONTEND_ORIGIN=https://coach.example.com

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=coach
POSTGRES_USER=coach
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# Container hostname "postgres" is the compose service name.
DATABASE_URL=postgresql://coach:CHANGE_ME_strong_db_password@postgres:5432/coach
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Session -----------------------------------------------------------------
AUTH_COOKIE_NAME=ai_job_session
AUTH_COOKIE_SECURE=true
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Invite-only signup ------------------------------------------------------
REGISTRATION_REQUIRE_INVITE=true
INVITE_DEFAULT_EXPIRES_DAYS=7
INVITE_RESUME_QUOTA=5

# --- LLM provider ------------------------------------------------------------
LLM_PROVIDER=compatible
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=CHANGE_ME_llm_key
LLM_MODEL_CHEAP=deepseek-v4-pro
LLM_MODEL_STRONG=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=8192
LLM_THINKING_ENABLED=false
LLM_REASONING_EFFORT=
RESUME_QUALITY_GATE_ENABLED=true

# --- Private object storage (MinIO in this stack) ----------------------------
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=coach-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME_minio_access_key
S3_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_key
S3_PREFIX=
S3_USE_PATH_STYLE=true

# --- Payments (disabled in MVP-1) --------------------------------------------
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# --- Limits and retention ----------------------------------------------------
MAX_UPLOAD_MB=10
DATA_RETENTION_DAYS=180
DELETION_GRACE_DAYS=7
JOB_STALE_DAYS=45
JOB_SOURCE_ALLOWED_HOSTS=

# --- Demo accounts -----------------------------------------------------------
# The seed script never runs in production, but the settings validator still
# requires these to be non-default, distinct, and at least 12 characters.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=CHANGE_ME_distinct_admin_password
DEMO_ADVISOR_EMAIL=advisor@example.com
DEMO_ADVISOR_PASSWORD=CHANGE_ME_distinct_advisor_password
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=CHANGE_ME_distinct_user_password
